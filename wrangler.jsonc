{
  "name": "freedom-erp-crm-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [{"name": "WORKSPACES", "class_name": "BusinessWorkspace"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["BusinessWorkspace"]}],
  "vars": {"DEFAULT_INDUSTRY": "retail", "DEFAULT_COMPANY": "自由工坊示範商店", "PUBLIC_DEMO": "true", "RETENTION_HOURS": "72"},
  "observability": {"enabled": true, "logs": {"enabled": false, "invocation_logs": false}}
}
